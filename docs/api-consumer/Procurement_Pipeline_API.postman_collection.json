              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text",
                "disabled": false
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/workbench/projects/{{project_id}}/report/generate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "workbench",
                "projects",
                "{{project_id}}",
                "report",
                "generate"
              ]
            }
          }
        },
        {
          "name": "Read JSON report",
          "request": {
            "method": "GET",
