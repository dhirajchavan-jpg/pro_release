              },
              {
                "key": "Idempotency-Key",
                "value": "{{evaluation_key}}"
              }
            ],
            "url": "{{base_url}}/v1/pipeline/fixed-schema/bids/evaluate",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"vendor_id\": \"{{vendor_id}}\"\n}",
              "options": {
