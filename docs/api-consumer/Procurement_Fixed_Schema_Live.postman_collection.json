            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Evaluation response is internally consistent', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  const s = body.summary;",
                  "  pm.expect(s.passed + s.failed + s.missing + s.needs_manual_review).to.eql(s.total);",
                  "  pm.expect(body.criteria_results).to.have.length(s.total);",
                  "  if (s.needs_manual_review > 0) pm.expect(body.manual_review.required).to.eql(true);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('evaluation_id', body.evaluation_id);"
                ]
              }
