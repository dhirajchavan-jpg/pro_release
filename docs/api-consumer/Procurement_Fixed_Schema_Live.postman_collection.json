        {
          "name": "Get BHEL evaluation view",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/v1/pipeline/fixed-schema/projects/{{project_id}}/bids/{{vendor_id}}/evaluation/bhel",
            "description": "Optional BHEL Noting-derived view. The fixed v1 evaluation response remains unchanged."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('BHEL evaluation view is valid', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.schema_version).to.eql('bhel-bid-evaluation.v1');",
                  "  pm.expect(body.profile_id).to.eql('bhel_purchase_materials');",
                  "  pm.expect(body).to.have.property('checks');",
                  "  pm.expect(body).to.have.property('internal_controls');",
                  "  pm.expect(body).to.have.property('bidder_summary');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
