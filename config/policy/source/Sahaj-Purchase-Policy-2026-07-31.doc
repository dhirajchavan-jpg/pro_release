<tr >
<td  valign="top">
<p  >16.2</p>
</td>
<td  valign="top">
<p  ><strong>PETTY PURCHASES OR&nbsp;&nbsp;PURCHASES WITH LESS THAN THREE QUOTATIONS</strong></p>
</td>
<td  valign="top">
<p  >1</p>
</td>
