# Select exactly one provider. There is no automatic provider fallback.
# gemini keeps the proven native generateContent route. openai_compatible uses the OpenAI SDK
# (for example, an OpenAI-compatible Gemini or Yotta endpoint).
AI_PROVIDER=gemini
APP_ENV=production
API_HOST=127.0.0.1
API_PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
ALLOW_REMOTE_API=0
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL_FAST=gemini-3.7-flash
AI_MODEL_DEEP=gemini-3.7-flash
AI_MODEL_UNDERSTANDING=gemini-2.5-flash
AI_MODEL_SOURCE_EXTRACTION=gemini-3.1-flash-lite
AI_MODEL_OCR=gemini-3.7-flash
AI_OCR_PROVIDER=
AI_OCR_RESPONSE_FORMAT=json_object
AI_OCR_PROMPT=OCR: Return plain text only. Do not emit Unicode control characters. Replace any unreadable glyph with a question mark.
AI_MODEL_EMBEDDING=gemini-embedding-2
AI_MODEL_RERANKER=gemini-3.7-flash
AI_MODEL_VERIFIER=gemini-3.7-flash
# Optional premium model identifier. It is never selected or used as a fallback.
AI_MODEL_PREMIUM=
AI_VERIFIER_SUPPORTS_VISION=1
# Google Gemini OpenAI-compatible URL for capability calls. Replace each URL/model/key
# with the matching BHEL/Yotta deployment; empty capability keys inherit AI_API_KEY.
AI_PRIMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_OCR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_RERANKER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_VERIFIER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_PRIMARY_DEPLOYMENT_ID=
AI_OCR_DEPLOYMENT_ID=
AI_EMBEDDING_DEPLOYMENT_ID=
AI_RERANKER_DEPLOYMENT_ID=
AI_VERIFIER_DEPLOYMENT_ID=
AI_PRIMARY_API_KEY=
AI_OCR_API_KEY=
AI_OCR_API_KEY_FILE=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_API_KEY_FILE=
AI_RERANKER_API_KEY=
AI_RERANKER_API_KEY_FILE=
AI_VERIFIER_API_KEY=
AI_VERIFIER_API_KEY_FILE=
# BHEL/Yotta production model values (replace capability URLs when issued):
# AI_MODEL_FAST=Qwen/Qwen3-235B-A22B-Thinking-2507-FP8
# AI_MODEL_DEEP=Qwen/Qwen3-235B-A22B-Thinking-2507-FP8
# AI_MODEL_OCR=PaddlePaddle/PaddleOCR-VL-1.6
# AI_MODEL_EMBEDDING=Qwen/Qwen3-Embedding-8B
# AI_MODEL_RERANKER=Qwen/Qwen3-Reranker-8B
# AI_MODEL_VERIFIER=Qwen/Qwen3-235B-A22B-Thinking-2507-FP8
# AI_MODEL_PREMIUM=Qwen/Qwen3.5-397B-A17B-FP8
# AI_VERIFIER_SUPPORTS_VISION=0
AI_OPENAI_RESPONSE_FORMAT=json_object
# Native schema-constrained JSON for schema-driven primary/verifier calls.
AI_PRIMARY_RESPONSE_FORMAT=json_schema
AI_VERIFIER_RESPONSE_FORMAT=json_schema
AI_PRIMARY_CONTEXT_TOKENS=131072
AI_VERIFIER_CONTEXT_TOKENS=131072
AI_OCR_CONTEXT_TOKENS=32768
AI_RERANKER_CONTEXT_TOKENS=32768
AI_PRIMARY_MAX_OUTPUT_TOKENS=8192
AI_VERIFIER_MAX_OUTPUT_TOKENS=8192
AI_PRIMARY_ENABLE_THINKING=
AI_VERIFIER_ENABLE_THINKING=
AI_OCR_MAX_OUTPUT_TOKENS=4096
AI_OCR_FREQUENCY_PENALTY=1.0
AI_RERANKER_MAX_OUTPUT_TOKENS=4096
AI_RERANKER_CANDIDATE_CHARS=1800
# chat uses OpenAI chat completions; rerank uses the standard /v1/rerank payload.
AI_RERANKER_API_STYLE=chat
AI_CONTEXT_SAFETY_PERCENT=10
AI_CONTEXT_CHARS_PER_TOKEN=3
AI_IMAGE_ESTIMATED_TOKENS=2048
AI_MAX_OUTPUT_TOKENS=4096
AI_THINKING_BUDGET=0
AI_REQUEST_TIMEOUT_SECONDS=180
AI_RETRY_ATTEMPTS=5
AI_RETRY_BASE_SECONDS=20
AI_RETRY_MAX_DELAY_SECONDS=60
AI_RETRY_JITTER_SECONDS=0.25
# Some scaled-to-zero Yotta routes return nginx 404 while waking. Keep 404 out unless observed.
AI_RETRY_HTTP_STATUS_CODES=408,429,500,502,503,504
# Shared load gate for primary and verifier calls to the same large-model deployment.
AI_LLM_CONCURRENCY=16
# Keep image verification bounded while allowing two independent pages to progress.
AI_VISION_CONCURRENCY=12
AI_OCR_CONCURRENCY=16
AI_EMBEDDING_CONCURRENCY=12
AI_RERANKER_CONCURRENCY=8
AI_LLM_REQUEST_TIMEOUT_SECONDS=420
AI_VISION_REQUEST_TIMEOUT_SECONDS=420
AI_OCR_REQUEST_TIMEOUT_SECONDS=300
AI_EMBEDDING_REQUEST_TIMEOUT_SECONDS=120
AI_RERANKER_REQUEST_TIMEOUT_SECONDS=240
AI_LLM_RETRY_ATTEMPTS=2
AI_VISION_RETRY_ATTEMPTS=2
AI_OCR_RETRY_ATTEMPTS=3
AI_EMBEDDING_RETRY_ATTEMPTS=2
AI_RERANKER_RETRY_ATTEMPTS=2
AI_RERANKER_JSON_ATTEMPTS=2
AI_PROVIDER_QUEUE_TIMEOUT_SECONDS=900
AI_PROVIDER_FAILURE_COOLDOWN_SECONDS=30
# Yotta deployments may scale to zero. One tiny request warms an idle LLM before work fans out.
AI_LLM_WARMUP_ENABLED=1
AI_LLM_WARM_TTL_SECONDS=300
AI_UNDERSTANDING_EARLY_WARMUP_ENABLED=1
AI_PROVIDER_HEALTHCHECK_ENABLED=0
AI_PROVIDER_HEALTHCHECK_REQUIRED=1
AI_PROVIDER_HEALTHCHECK_TIMEOUT_SECONDS=10
AI_PROVIDER_HEALTHCHECK_ATTEMPTS=1
AI_PROVIDER_HEALTHCHECK_RETRY_SECONDS=5
# India-only inference is an explicit deployment assertion; enforce egress at infrastructure level too.
AI_REQUIRE_INDIA_REGION=0
AI_INFERENCE_REGION=

# PostgreSQL is the authoritative application database. Do not use SQLite/local JSON in production.
DATABASE_URL=postgresql+psycopg://procurement:replace_me@localhost:5432/procurement
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
LOCAL_POSTGRES_ENABLED=1
LOCAL_POSTGRES_PORT=55432
LOCAL_POSTGRES_USER=procurement_app
LOCAL_POSTGRES_PASSWORD=replace_with_generated_local_postgres_password
LOCAL_POSTGRES_DB=procurement
POSTGRES_DB=procurement
POSTGRES_USER=procurement
# Informational only: Setup does not create PostgreSQL users/databases; DATABASE_URL is authoritative.
POSTGRES_PASSWORD=replace_with_local_postgres_password

# Use filesystem for a single local Windows server; switch to S3-compatible storage when required.
OBJECT_STORAGE_BACKEND=filesystem
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PREFIX=procurement
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_ADDRESSING_STYLE=auto
OBJECT_STORAGE_CA_BUNDLE=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
# Local single-server object root.
OBJECT_STORAGE_LOCAL_ROOT=runtime/objects
RETENTION_DAYS=0
RETENTION_BATCH_SIZE=100
MINIO_ROOT_USER=replace_with_minio_access_key
MINIO_ROOT_PASSWORD=replace_with_minio_secret_key
WORKER_POLL_SECONDS=3
WORKER_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=1
# Price/commercial bidder documents stay quarantined until an authorized opening.
COMMERCIAL_OPENING_ENABLED=0
BID_EVALUATION_PROFILE=bhel_purchase_materials
COMPLIANCE_TENDER_CHUNK_CHARS=1800
COMPLIANCE_TENDER_BATCH_SIZE=10
COMPLIANCE_POLICY_BATCH_SIZE=24
COMPLIANCE_RETRIEVAL_TOP_K=5
COMPLIANCE_MAX_CONTEXT_CANDIDATES=24
COMPLIANCE_EMBED_BATCH_SIZE=64
COMPLIANCE_LLM_CONCURRENCY=8
BID_EVALUATION_PROFILE_FILE=config/bid_evaluation.bhel.v1.json

# Legacy Gemini aliases remain supported only when AI_PROVIDER=gemini.
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL_FAST=gemini-3.7-flash
GEMINI_MODEL_DEEP=gemini-3.7-flash
GEMINI_MODEL_EMBEDDING=gemini-embedding-2
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MAX_OUTPUT_TOKENS=65536
GEMINI_THINKING_BUDGET=0
GEMINI_REQUEST_TIMEOUT_SECONDS=45
GEMINI_RETRY_ATTEMPTS=2
GEMINI_RETRY_BASE_SECONDS=20
# Immutable label attached to every metered call. Change it whenever a provider
# price or the USD/INR conversion used for reporting changes.
AI_PRICING_REVISION=
USD_TO_INR_RATE=
PROVIDER_USAGE_REQUIRED=1
AI_BUDGET_LIMIT_INR=500
# This tenant-wide stop does not change model, context, or output-token settings.
# New paid calls stop after recorded spend reaches the limit; in-flight calls finish.
AI_FAST_INPUT_COST_PER_MILLION_TOKENS=
AI_FAST_OUTPUT_COST_PER_MILLION_TOKENS=
AI_DEEP_INPUT_COST_PER_MILLION_TOKENS=
AI_DEEP_OUTPUT_COST_PER_MILLION_TOKENS=
AI_UNDERSTANDING_INPUT_COST_PER_MILLION_TOKENS=0.30
AI_UNDERSTANDING_OUTPUT_COST_PER_MILLION_TOKENS=2.50
AI_SOURCE_EXTRACTION_INPUT_COST_PER_MILLION_TOKENS=0.25
AI_SOURCE_EXTRACTION_OUTPUT_COST_PER_MILLION_TOKENS=1.50
AI_VERIFIER_INPUT_COST_PER_MILLION_TOKENS=
AI_VERIFIER_OUTPUT_COST_PER_MILLION_TOKENS=
AI_OCR_INPUT_COST_PER_MILLION_TOKENS=
AI_OCR_OUTPUT_COST_PER_MILLION_TOKENS=
AI_EMBEDDING_INPUT_COST_PER_MILLION_TOKENS=
AI_EMBEDDING_COST_PER_REQUEST_USD=
AI_RERANKER_INPUT_COST_PER_MILLION_TOKENS=
AI_RERANKER_OUTPUT_COST_PER_MILLION_TOKENS=
AI_RERANKER_COST_PER_REQUEST_USD=
OPENPARSER_COST_PER_PAGE_USD=
PADDLEOCR_COST_PER_PAGE_USD=

# Authentication & Sessions
# Dedicated HMAC session signing key (keep secret, never reuse as an API token).
SESSION_SECRET_KEY=replace_with_64_char_random_hex
# AUTH_MODE: 'session' (database-backed users & scoped API keys) or 'jwt' (enterprise SSO / OIDC)
AUTH_MODE=session
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=0

# Enterprise OIDC / JWT Settings (used when AUTH_MODE=jwt)
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_TENANT_CLAIM=tenant_id
AUTH_ROLES_CLAIM=roles
RATE_LIMIT_PER_MINUTE=300
# One running operation plus ten pending bidder operations.
MAX_QUEUED_OPERATIONS=11
WORKER_HEARTBEAT_FILE=runtime/worker.heartbeat.json
WORKER_HEARTBEAT_SECONDS=10
WORKER_HEARTBEAT_MAX_AGE_SECONDS=30
WORKER_TEMP_STALE_SECONDS=86400
WORKER_RETRY_BASE_SECONDS=30
WORKER_RETRY_MAX_SECONDS=300
OPERATION_LEASE_SECONDS=300
OPERATION_STALE_SECONDS=300
SUPERVISOR_LAUNCHER_TIMEOUT_SECONDS=180
MIN_AVAILABLE_MEMORY_MB=512
MIN_FREE_DISK_MB=1024
MAX_UPLOAD_MB=50
MAX_BIDDERS_PER_TENDER=10
MAX_RUNNING_JOBS=1
MAX_JOB_SECONDS=3600
# Setup points this to the bundled headless LibreOffice runtime.
OFFICE_CONVERTER_BIN=replace_with_setup_managed_libreoffice_path
OFFICE_CONVERTER_TIMEOUT_SECONDS=120
RUNTIME_DIR=runtime
# Setup writes an absolute short path here when the installation path is long.
PYTHON_RUNTIME_DIR=
LOG_LEVEL=INFO
API_ACCESS_LOG=1
# Test and diagnostic switch only. Production preflight requires this to remain 0.
PROCUREMENT_OFFLINE_LLM=0

JOBS_ROOT=runtime/jobs
PROMPT_OVERRIDES_FILE=
PROCUREMENT_DOCUMENT_DICTIONARY_FILE=config/procurement_document_dictionary.json

ENABLE_GEMINI_OCR=0
TARGETED_OCR_ENABLED=1
VISUAL_SIGNATURE_ENABLED=1
VISUAL_SIGNATURE_MAX_PAGES=3
EVIDENCE_VISION_ENABLED=1
EVIDENCE_VISION_MAX_PAGES=6
EVIDENCE_VISION_MIN_TEXT_QUALITY=0.80
GEMINI_CRITERION_JUDGE_ENABLED=1
CRITERION_JUDGE_BATCH_SIZE=12
EVIDENCE_VERIFICATION_BATCH_SIZE=8
EVIDENCE_VERIFICATION_BATCH_MAX_IMAGES=16

MAX_EXTRACTED_FILES=80
MAX_EXTRACTED_MB=250
MAX_ZIP_ENTRY_MB=80
MAX_ZIP_COMPRESSION_RATIO=200
MAX_PDF_PAGES=500
PDF_OCR_MAX_PAGES=0
BASE_RFP_OCR_ENABLED=1
# 0 means no page cap: every weak tender-side PDF page is OCRed before base-RFP identification.
BASE_RFP_OCR_MAX_PAGES=0
BASE_RFP_OCR_PROVIDER=openparser
BASE_RFP_PADDLE_DEVICE=gpu
# openparser uses hosted PaddleOCR-VL-1.6 only for pages requiring OCR. Set
# provider=ai for OpenAI-compatible OCR, paddle_api for Paddle's official API,
# or provider=paddle for an installed local runtime.
OPENPARSER_API_KEY=
OPENPARSER_BASE_URL=https://api.openparser.dev
OPENPARSER_OCR_MODEL=paddleocr-vl-1.6
OPENPARSER_MAX_RESPONSE_MB=50
PADDLEOCR_ACCESS_TOKEN=
PADDLEOCR_BASE_URL=
BASE_RFP_PADDLE_API_MODEL=PaddleOCR-VL-1.6
BASE_RFP_PADDLE_API_BATCH_PAGES=2
BASE_RFP_PADDLE_API_REQUEST_TIMEOUT_SECONDS=120
BASE_RFP_PADDLE_API_POLL_TIMEOUT_SECONDS=600
BASE_RFP_PADDLE_API_CONCURRENCY=6
BASE_RFP_PADDLE_API_RETRY_ATTEMPTS=3
PADDLEOCR_USE_SEAL_RECOGNITION=1
PADDLEOCR_USE_OCR_FOR_IMAGE_BLOCK=1
PADDLE_OCR_MODE=hosted
PADDLE_OCR_CACHE_DIR=runtime\paddle-cache
OCR_RESULT_CACHE_DIR=runtime\cache\ocr-results
EMBEDDING_CACHE_ENABLED=1
EMBEDDING_CACHE_DIR=runtime\cache\embeddings
LLM_JSON_CACHE_ENABLED=1
LLM_JSON_CACHE_DIR=runtime\cache\llm-json
AI_CACHE_REVISION=1
AI_EMBEDDING_BATCH_SIZE=96
AI_EMBEDDING_DIMENSIONS=3072
AI_EMBEDDING_MEMORY_CACHE_ITEMS=4096
AI_EMBEDDING_TIMEOUT_SECONDS=120
BASE_RFP_OCR_MIN_CONFIDENCE=0.65
NATIVE_TEXT_INTEGRITY_GATE_ENABLED=1
# 0 means any non-printable/replacement/cid artifact in the independent native extraction triggers OCR.
NATIVE_TEXT_ARTIFACT_RATIO=0
# Route substitution-cipher/native-font extraction and repeated header-only pages through OCR.
NATIVE_TEXT_LONG_TOKEN_CHARS=80
NATIVE_TEXT_LONG_TOKEN_RATIO=0.25
REPEATED_BOILERPLATE_MIN_PAGES=3
REPEATED_BOILERPLATE_MIN_LINE_CHARS=30
# Deprecated: no provider/model fallback is permitted in production.
BASE_RFP_VISUAL_OCR_FALLBACK_ENABLED=0
# Optional: review only high-risk heading/hierarchy pages with Gemini, then rebuild the structure.
BASE_RFP_STRUCTURAL_ADJUDICATION_ENABLED=0
BASE_RFP_STRUCTURAL_REVIEW_MAX_PAGES=12
BASE_RFP_STRUCTURAL_REVIEW_CONCURRENCY=3
EVIDENCE_RELEVANT_OCR_MAX_PAGES=60
TARGETED_OCR_MAX_PAGES=18
OCR_CONCURRENCY=16
OCR_RETRY_ATTEMPTS=2
OCR_FAILURE_POLICY=fail
OCR_TILE_MAX_DEPTH=3
OCR_TILE_OVERLAP_PERCENT=2
MAX_DOC_CHARS=50000
MAX_TOTAL_CHARS=14000
TENDER_PAGE_LEDGER_MAX_PAGES=350
TENDER_PAGE_LEDGER_PAGE_CHARS=3000
TENDER_LLM_LEDGER_MAX_PAGES=140
TENDER_EXTRACTION_CHUNK_PAGES=10
TENDER_EXTRACTION_CONCURRENCY=6
# Workbench tender understanding resolves only the pinned client fields from
# locally retrieved source candidates. These are hard call/evidence bounds.
RFP_FIELD_INITIAL_CANDIDATES=8
RFP_FIELD_EXPANDED_CANDIDATES=16
RFP_FIELD_INITIAL_EVIDENCE_CHARS=9000
RFP_FIELD_EXPANDED_EVIDENCE_CHARS=16000
RFP_FIELD_MAX_ROUNDS=3
RFP_FIELD_MAX_IMAGES=3
# Leave images out of the first field call. The compiler requests the VLM only
# when text evidence or validation is uncertain; set to 1 only for diagnostics.
RFP_FIELD_EAGER_VISUAL_ENABLED=0
RFP_FIELD_MAX_IMAGE_CALLS=
RFP_FIELD_MAX_OUTPUT_TOKENS=8192
RFP_FIELD_MAX_TOTAL_CALLS=
# Resolve small groups of independently retrieved field dossiers in one model
# request; missing or invalid batch items automatically fall back per field.
RFP_FIELD_BATCH_SIZE=1
RFP_FIELD_CONCURRENCY=16
SOURCE_OBLIGATION_CONCURRENCY=12
SOURCE_RECONCILIATION_CONCURRENCY=12
# Leave expensive semantic overlap review off. Exact duplicates are still collapsed deterministically.
SOURCE_RECONCILIATION_AI_ENABLED=0
# Leave recursive model retries off. Unresolved source units remain visible for human review.
SOURCE_OBLIGATION_TARGETED_RECOVERY_ENABLED=1
RFP_FIELD_THINKING_BUDGET=0
RFP_FIELD_JSON_RETRY=1
# Read a few requirement-dense page clusters once with the VLM, then reuse the
# grounded page facts in all 31 field resolvers. The normal retrieval path
# remains active for facts outside these anchor pages.
RFP_ANCHOR_PAGES_ENABLED=1
RFP_ANCHOR_MAX_CLUSTERS=4
RFP_ANCHOR_PAGES_PER_CLUSTER=4
RFP_ANCHOR_MIN_SCORE=45
RFP_ANCHOR_CONCURRENCY=2
RFP_ANCHOR_MAX_OUTPUT_TOKENS=8192
RFP_AMENDMENT_EVIDENCE_CHARS=18000
RFP_AMENDMENT_MAX_CALLS=24
RFP_AMENDMENT_MAX_IMAGES=2
RFP_AMENDMENT_OUTPUT_TOKENS=1200
BASE_RFP_AMENDMENT_TARGETS_PER_CHUNK=40
# Legacy /evaluate canonical-atom settings. The PostgreSQL workbench
# understanding worker does not use this exhaustive atom sweep.
BASE_RFP_CHUNK_MAX_UNITS=60
BASE_RFP_CHUNK_MAX_SOURCE_CHARS=24000
BASE_RFP_ATOM_MAX_OUTPUT_TOKENS=4096
BASE_RFP_ATOM_OUTPUT_TOKENS_PER_UNIT=48
BASE_RFP_EXTRACTION_CONCURRENCY=6
TENDER_EXTRACTION_SYNTHESIS_ENABLED=0
TENDER_REQUIREMENT_CONSOLIDATION_ENABLED=1
LLM_CLASSIFY_CHARS=3000
MAX_LLM_PAGE_CLASSIFICATIONS=30
BID_CLASSIFICATION_CONCURRENCY=12
EVIDENCE_PDF_RENDER_CACHE_PAGES=48
BID_SUMMARY_BATCH_DOCUMENTS=10
BID_SUMMARY_BATCH_CHARS=50000
BID_SUMMARY_DOCUMENT_CHARS=30000
VENDOR_PROFILE_BATCH_DOCUMENTS=12
VENDOR_PROFILE_BATCH_CHARS=40000
VENDOR_PROFILE_DOCUMENT_CHARS=12000
BID_SUMMARY_ROUTE_MAX_DOCUMENTS=12
BID_EVIDENCE_ROUTE_MAX_DOCUMENTS=4
BID_EVIDENCE_ROUTE_MAX_PAGES=6
EVIDENCE_VERIFIER_PAGE_CHARS=2500
OCR_MIN_PAGE_CHARS=40
DETERMINISTIC_CRITERION_VALIDATORS_ENABLED=1
EVIDENCE_PACKET_MAX_PAGES=12
EVIDENCE_PACKET_NEIGHBOR_PAGES=1
EVIDENCE_LEDGER_CHUNK_PAGES=5
EVIDENCE_OCR_DOCUMENT_SIGNAL_PAGES=12
EVIDENCE_SCOUT_ENABLED=1
EVIDENCE_SCOUT_PAGES_PER_CALL=8
EVIDENCE_SCOUT_MAX_PAGE_CHARS=5000
EVIDENCE_SCOUT_MAX_CANDIDATES=12
EVIDENCE_SCOUT_CONCURRENCY=12
VERIFICATION_CONCURRENCY=12
EVIDENCE_RECOVERY_MAX_ROUNDS=0
EVIDENCE_RECOVERY_MAX_SECONDS=45
EVIDENCE_RECOVERY_MAX_PAGES_PER_ROUND=12
EVIDENCE_EMBEDDING_CHUNK_CHARS=4000
EVIDENCE_EMBEDDING_CHUNK_OVERLAP=400
EVIDENCE_SCOUT_MAX_PAGES_PER_EVIDENCE=48
EVIDENCE_RERANKER_ENABLED=0
EVIDENCE_OBJECTIVE_MAX_DOCUMENTS=3
EVIDENCE_OBJECTIVE_SEMANTIC_POOL=24
EVIDENCE_OBJECTIVE_RERANK_CANDIDATES=8
EVIDENCE_OBJECTIVE_FINAL_PAGES=4
EVIDENCE_STANDARD_MAX_DOCUMENTS=4
EVIDENCE_STANDARD_SEMANTIC_POOL=64
EVIDENCE_STANDARD_RERANK_CANDIDATES=16
EVIDENCE_STANDARD_FINAL_PAGES=6
EVIDENCE_BROAD_MAX_DOCUMENTS=8
EVIDENCE_BROAD_SEMANTIC_POOL=128
EVIDENCE_BROAD_RERANK_CANDIDATES=32
EVIDENCE_BROAD_FINAL_PAGES=16
EVIDENCE_EMBEDDING_ENABLED=1
EVIDENCE_SEMANTIC_CANDIDATE_PAGES=64
RFP_FIELD_EMBEDDING_ENABLED=1
RFP_FIELD_RERANKER_ENABLED=0
SOURCE_OBLIGATION_VISION_MIN_TEXT_QUALITY=0.80
RFP_FIELD_SEMANTIC_POOL=32
RFP_FIELD_RERANK_CANDIDATES=12
# Comma-separated browser origins allowed to call the API with credentials.
# Keep this explicit; do not use * when browser sessions/cookies are enabled.
FRONTEND_CORS_ORIGINS=http://127.0.0.1:5173
